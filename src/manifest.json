{
  "schema_version": 2,
  "api_version": "2",
  "plugin_id": "homex.hxcs",
  "name": "HXCS 社区商店",
  "version": "1.0.17",
  "type": "service_integration",
  "runtime": "python",
  "publisher": {
    "id": "hx-community",
    "display_name": "HX Community",
    "homepage": "https://homex.dev"
  },
  "entry": {
    "python": "runtime/hxcs_worker.py",
    "ui": "ui/index.html",
    "ui_default": "native"
  },
  "description": "HOMEX Community Store：社区插件商店 + HA 兼容运行时。安装后开启「社区插件」显示社区注册表中的第三方插件；开启「兼容 HA 插件」后可加载并运行 HA 风格集成包。单插件，无独立进程，无独立端口。",
  "permissions": [
    "network.outbound",
    "config.read"
  ],
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "community_enabled": {
        "type": "boolean",
        "default": false,
        "title": "启用社区插件",
        "description": "开启后市场页显示社区注册表中的第三方插件。"
      },
      "ha_compat_enabled": {
        "type": "boolean",
        "default": false,
        "title": "兼容 HA 插件",
        "description": "开启后支持 HA 风格集成包的加载与运行。"
      },
      "registry_url": {
        "type": "string",
        "format": "uri",
        "default": "https://raw.githubusercontent.com/1169892406/HXCS/main",
        "title": "注册表地址"
      },
      "proxy_url": {
        "type": "string",
        "default": "",
        "title": "下载代理",
        "description": "HTTP 或 SOCKS5 代理地址，加速 GitHub 下载。留空直连。"
      },
      "network_allowed_hosts": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "HA 集成出站时允许访问的域名（逗号分隔）。留空 = 一律拒绝（fail-closed）。",
        "title": "出站白名单"
      }
    }
  },
  "limits": {
    "max_memory_mb": 256,
    "execution_timeout_ms": 30000
  },
  "signature": {
    "algorithm": "ed25519",
    "key_id": "hx-mi-community"
  },
  "min_api_version": "2",
  "provides": {
    "tools": [
      {
        "name": "catalog_list",
        "title": "读取注册表"
      },
      {
        "name": "catalog_fetch"
      },
      {
        "name": "community_status",
        "title": "商店状态"
      },
      {
        "name": "integration_load",
        "title": "加载集成"
      },
      {
        "name": "config_flow",
        "title": "配置 HA 集成",
        "args_schema": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "title": "集成标识",
              "description": "如 midea_ac_lan",
              "x-options-from": "integrations_list"
            },
            "step": {
              "type": "string",
              "title": "步骤",
              "default": "user",
              "description": "user / discovery / auto / login …"
            }
          },
          "required": [
            "domain"
          ]
        }
      },
      {
        "name": "entry_setup",
        "title": "启动集成"
      },
      {
        "name": "entry_reload",
        "title": "重载集成"
      },
      {
        "name": "entry_remove",
        "title": "移除集成"
      },
      {
        "name": "service_call",
        "title": "调用服务",
        "args_schema": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "title": "域",
              "description": "如 light / switch"
            },
            "service": {
              "type": "string",
              "title": "服务",
              "description": "如 turn_on"
            },
            "entity_id": {
              "type": "string",
              "title": "实体 ID",
              "description": "可选"
            }
          },
          "required": [
            "domain",
            "service"
          ]
        }
      },
      {
        "name": "integrations_list",
        "title": "集成列表"
      },
      {
        "name": "integration_install",
        "title": "安装集成"
      },
      {
        "name": "integration_remove",
        "title": "卸载集成"
      },
      {
        "name": "test_connection",
        "risk": "low",
        "description": "探测注册表可达性（走插件侧代理/直连回退），返回可分类结论",
        "title": "获取插件"
      }
    ],
    "views": [
      {
        "name": "registered_plugins",
        "title": "注册插件",
        "description": "注册表提供的插件清单（HXC 商店插件与 HA 集成包）。",
        "tool": "catalog_list",
        "columns": [
          {
            "title": "插件",
            "field": "name"
          },
          {
            "title": "标识",
            "field": "plugin_id",
            "kind": "mono"
          },
          {
            "title": "版本",
            "field": "version",
            "kind": "mono",
            "suffix": ""
          },
          {
            "title": "类型",
            "field": "type",
            "kind": "badge"
          }
        ]
      }
    ]
  },
  "changelog": "1.0.17：给工具声明**显示名**（test_connection → 「获取插件」等）与**参数 schema**（config_flow / service_call）。平台据此渲染按钮文案与参数表单，插件不再需要靠自带界面暴露这些入口 —— 这正是 HA「插件只声明 schema、框架渲染」的做法。"
}
