{
  "schema_version": 2,
  "api_version": "2",
  "plugin_id": "homex.hxcs",
  "name": "HXCS 社区商店",
  "version": "1.0.16",
  "type": "service_integration",
  "runtime": "python",
  "publisher": {
    "id": "hx-community",
    "display_name": "HX Community",
    "homepage": "https://homex.dev"
  },
  "entry": {
    "python": "runtime/hxcs_worker.py",
    "ui": "ui/index.html",
    "ui_default": "native"
  },
  "description": "HOMEX Community Store：社区插件商店 + HA 兼容运行时。安装后开启「社区插件」显示社区注册表中的第三方插件；开启「兼容 HA 插件」后可加载并运行 HA 风格集成包。单插件，无独立进程，无独立端口。",
  "permissions": [
    "network.outbound",
    "config.read"
  ],
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "community_enabled": {
        "type": "boolean",
        "default": false,
        "title": "启用社区插件",
        "description": "开启后市场页显示社区注册表中的第三方插件。"
      },
      "ha_compat_enabled": {
        "type": "boolean",
        "default": false,
        "title": "兼容 HA 插件",
        "description": "开启后支持 HA 风格集成包的加载与运行。"
      },
      "registry_url": {
        "type": "string",
        "format": "uri",
        "default": "https://raw.githubusercontent.com/1169892406/HXCS/main",
        "title": "注册表地址"
      },
      "proxy_url": {
        "type": "string",
        "default": "",
        "title": "下载代理",
        "description": "HTTP 或 SOCKS5 代理地址，加速 GitHub 下载。留空直连。"
      },
      "network_allowed_hosts": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "HA 集成出站时允许访问的域名（逗号分隔）。留空 = 一律拒绝（fail-closed）。",
        "title": "出站白名单"
      }
    }
  },
  "limits": {
    "max_memory_mb": 256,
    "execution_timeout_ms": 30000
  },
  "signature": {
    "algorithm": "ed25519",
    "key_id": "hx-mi-community"
  },
  "min_api_version": "2",
  "provides": {
    "tools": [
      {
        "name": "catalog_list"
      },
      {
        "name": "catalog_fetch"
      },
      {
        "name": "community_status"
      },
      {
        "name": "integration_load"
      },
      {
        "name": "config_flow"
      },
      {
        "name": "entry_setup"
      },
      {
        "name": "entry_reload"
      },
      {
        "name": "entry_remove"
      },
      {
        "name": "service_call"
      },
      {
        "name": "integrations_list"
      },
      {
        "name": "integration_install"
      },
      {
        "name": "integration_remove"
      },
      {
        "name": "test_connection",
        "risk": "low",
        "description": "探测注册表可达性（走插件侧代理/直连回退），返回可分类结论"
      }
    ],
    "views": [
      {
        "name": "registered_plugins",
        "title": "注册插件",
        "description": "注册表提供的插件清单（HXC 商店插件与 HA 集成包）。",
        "tool": "catalog_list",
        "columns": [
          {
            "title": "插件",
            "field": "name"
          },
          {
            "title": "标识",
            "field": "plugin_id",
            "kind": "mono"
          },
          {
            "title": "版本",
            "field": "version",
            "kind": "mono",
            "suffix": ""
          },
          {
            "title": "类型",
            "field": "type",
            "kind": "badge"
          }
        ]
      }
    ]
  },
  "changelog": "1.0.16：① 字段顺序与插件原生界面一致（社区插件 → 兼容 HA → 注册表源 → 下载代理 → 出站白名单）；② 声明 test_connection 诊断工具，让标准表单的「测试连通」按钮可用（平台的连接测试按钮只对声明了该工具的插件渲染）。"
}
