{
  "schema_version": 2,
  "api_version": "2",
  "plugin_id": "homex.hxcs",
  "name": "HXCS 社区商店",
  "version": "1.1.0",
  "type": "service_integration",
  "runtime": "wasm",
  "publisher": {
    "id": "hx-community",
    "display_name": "HX Community",
    "homepage": "https://homex.dev"
  },
  "entry": {
    "wasm": "plugin.wasm"
  },
  "description": "HOMEX Community Store 连接器：安装后在配置页开启「社区插件」，市场页即展示社区注册表（GitHub）中的全部插件，标识为第三方。社区内容由其来源方负责，HOMEX 不作担保。",
  "permissions": [
    "network.outbound",
    "config.read"
  ],
  "resources": {
    "http": {
      "timeout_ms": 15000,
      "max_redirects": 5,
      "max_response_bytes": 33554432
    }
  },
  "tools": [
    "catalog_list",
    "catalog_fetch",
    "community_status"
  ],
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "community_enabled": {
        "type": "boolean",
        "default": false,
        "title": "启用社区插件",
        "description": "开启后市场页显示社区注册表中的第三方插件。"
      },
      "registry_url": {
        "type": "string",
        "format": "uri",
        "default": "https://raw.githubusercontent.com/homex-community/hxcs-registry/main",
        "title": "注册表地址",
        "description": "社区插件索引的 base URL（index.json 所在目录）。"
      },
      "ha_compat_enabled": {
        "type": "boolean",
        "default": false,
        "title": "兼容 HA 插件",
        "description": "开启后 HXCS 支持 HA 风格集成包的展示与导入。关闭时仅作为社区插件商店使用。"
      }
    }
  },
  "limits": {
    "max_memory_mb": 32,
    "execution_timeout_ms": 20000,
    "max_storage_kb": 1024
  },
  "signature": {
    "algorithm": "ed25519",
    "key_id": "REPLACE_WITH_YOUR_KEY_ID"
  },
  "min_api_version": "2",
  "provides": {
    "tools": [
      {
        "name": "catalog_list",
        "risk": "low"
      },
      {
        "name": "catalog_fetch",
        "risk": "medium"
      },
      {
        "name": "community_status",
        "risk": "low"
      }
    ]
  },
  "changelog": "1.1.0: 新增「兼容 HA 插件」开关（默认关闭）。开启后支持 HA 风格集成包；关闭时仅作为社区插件商店。"
}